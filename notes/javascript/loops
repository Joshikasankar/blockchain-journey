switch :
      one variable but differemt value can ne solved by switch.
      it run eith the same data type.
      input is given in string but cases are given in number will not be acceptable.
    Example :
  // switch
 let op ='+';
let a= 10;
let b = 2;
 switch(op){
     case '+':
          console.log(a+b);
          break;
     case '-':
          console.log(a-b);
          break;
     case '/':
          console.log(a/b);
          break;
     case '*':
          console.log(a*b);
          break;
     case '%':
          console.log(a%b);
          break;
     default :
        console.log("invalid input");
 }



























