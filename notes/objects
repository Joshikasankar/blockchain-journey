Objects :
      it is also a data type.
      it act as key and value pairs.
      in objects keywords are also used as keys.
      if the key has a space it mast be given in string.
declaring a object :
          // objects 
         let a  = {};
         console.log(typeof a);  ------> output : object
// object :
let food = {
        fruits : "apple,mango , strawberry,banana",
        veggi : "carrot,beatroot,cabbage",
        price : 2000
};
console.log(food);

// extracting a particular value from the object
let food = {
        fruits : "apple,mango , strawberry,banana",
        veggi : "carrot,beatroot,cabbage",
        price : 2000
  };
console.log(food.veggi);
