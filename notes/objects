In objects variables are allowed for values in objects :
 Example :
    let rawveggi = "carrot,beans,sweetpotato";
 let food = {
        fruits : "apple,mango , strawberry,banana",
        veggi : rawveggi+",beatroot,cabbage",
        price : 2000
     };
       console.log(food.veggi);
